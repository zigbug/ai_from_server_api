    {
      "name": "Sessions",
      "description": "Сессии диалогов: создание, листинг, история, сообщения.\n\nИнструкция:\n1) Создайте сессию (POST /sessions) и скопируйте session_id.\n2) Вставьте его в переменную окружения sessionId.\n3) Остальные запросы сессии заработают.",
      "item": [
        {
          "name": "POST /sessions (создать)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const text = pm.response.text();",
                  "  if (!text) throw new Error('empty');",
                  "  const jsonData = JSON.parse(text);",
                  "  if (jsonData && jsonData.session_id) {",
                  "    pm.environment.set('sessionId', jsonData.session_id);",
                  "    console.log('sessionId set to:', jsonData.session_id);",
                  "  }",
                  "} catch (e) {",
                  "  console.log('Response is not JSON, skipping sessionId extraction:', e.message);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Игра 'Мастер подземелий'\",\n  \"model\": \"{{modelText}}\",\n  \"system_prompt\": \"Ты — мастер подземелий. Отвечай кратко и атмосферно.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["sessions"]
            }
          }
        },
        {
          "name": "GET /sessions (список)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["sessions"]
            }
          }
        },
        {
          "name": "GET /sessions/{id} (по ID)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}"]
            }
          }
        },
        {
          "name": "PATCH /sessions/{id} (обновить)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
