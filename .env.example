# Скопируйте этот файл в `.env` на сервере и заполните значения.

# Ключ Hugging Face (https://huggingface.co/settings/tokens)
HF_TOKEN=

# Ключ Groq для текстовых моделей (https://console.groq.com/keys).
# Если пуст — Groq-модели не показываются в списке.
GROQ_API_KEY=

# Ключ OpenRouter (free-роутер `openrouter/free` без баланса)
# OPENROUTER_API_KEY=

# Размер скользящего окна сообщений, передаваемых модели
CONTEXT_WINDOW=20

# Порог сообщений, после которого история сжимается в резюме
SUMMARY_THRESHOLD=40

# Модель генерации картинок по умолчанию
IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Модель редактирования картинок по умолчанию
IMAGE_EDIT_MODEL=black-forest-labs/FLUX.1-Kontext-dev